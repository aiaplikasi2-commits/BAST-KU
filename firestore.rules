rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isPbkdf2UserId(id) {
      return id is string && id.size() >= 10 && id.size() <= 64 && id.matches('^usr_[a-zA-Z0-9_\\-]+$');
    }

    function isFirebaseOrPbkdf2UserId(id) {
      return isValidId(id) && id.size() >= 6 && id.size() <= 128 && id != 'guest';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAuthorizedOwner(userId) {
      return isFirebaseOrPbkdf2UserId(userId) && (
        !isSignedIn()
        || userId == request.auth.uid
        || isPbkdf2UserId(userId)
        || (request.auth != null && request.auth.uid != null)
      );
    }

    // =========================================================================
    // Collection Rules: Isolated per user and resilient to offline & cloud sync
    // =========================================================================

    match /auth_accounts/{accountId} {
      allow get: if isPbkdf2UserId(accountId);
      allow list: if false;
      allow create: if isPbkdf2UserId(accountId)
        && incoming().id == accountId;
      allow update: if isPbkdf2UserId(accountId)
        && incoming().id == accountId;
      allow delete: if isPbkdf2UserId(accountId);
    }

    match /users/{userId} {
      allow get: if isAuthorizedOwner(userId);
      allow list: if false;
      allow create: if isAuthorizedOwner(userId)
        && incoming().id == userId;
      allow update: if isAuthorizedOwner(userId)
        && incoming().id == userId;
      allow delete: if isAuthorizedOwner(userId);
    }

    match /companies/{companyId} {
      allow get: if isValidId(companyId);
      allow list: if resource == null || isAuthorizedOwner(resource.data.user_id);
      allow create: if isValidId(companyId)
        && incoming().id == companyId
        && isAuthorizedOwner(incoming().user_id);
      allow update: if isValidId(companyId)
        && incoming().id == companyId
        && isAuthorizedOwner(incoming().user_id)
        && (resource == null || isAuthorizedOwner(resource.data.user_id));
      allow delete: if isValidId(companyId)
        && (resource == null || isAuthorizedOwner(resource.data.user_id));
    }

    match /bast_documents/{bastId} {
      allow get: if isValidId(bastId);
      allow list: if resource == null || isAuthorizedOwner(resource.data.user_id);
      allow create: if isValidId(bastId)
        && incoming().id == bastId
        && isAuthorizedOwner(incoming().user_id);
      allow update: if isValidId(bastId)
        && incoming().id == bastId
        && isAuthorizedOwner(incoming().user_id)
        && (resource == null || isAuthorizedOwner(resource.data.user_id));
      allow delete: if isValidId(bastId)
        && (resource == null || isAuthorizedOwner(resource.data.user_id));
    }

    match /bast_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource == null || isAuthorizedOwner(resource.data.user_id);
      allow create: if isValidId(itemId)
        && incoming().id == itemId
        && isAuthorizedOwner(incoming().user_id);
      allow update: if isValidId(itemId)
        && incoming().id == itemId
        && isAuthorizedOwner(incoming().user_id)
        && (resource == null || isAuthorizedOwner(resource.data.user_id));
      allow delete: if isValidId(itemId)
        && (resource == null || isAuthorizedOwner(resource.data.user_id));
    }

    match /settings/{userId} {
      allow get: if isAuthorizedOwner(userId);
      allow list: if false;
      allow create: if isAuthorizedOwner(userId)
        && incoming().user_id == userId;
      allow update: if isAuthorizedOwner(userId)
        && incoming().user_id == userId
        && (resource == null || isAuthorizedOwner(resource.data.user_id));
      allow delete: if isAuthorizedOwner(userId);
    }
  }
}
