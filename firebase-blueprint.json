  "firestore": {
    "/auth_accounts/{accountId}": {
      "schema": {
        "$ref": "#/entities/AuthAccount"
      },
      "description": "Encrypted PBKDF2-SHA256 Email/Password account records stored online."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profile document keyed by userId."
    },
    "/companies/{companyId}": {
      "schema": {
        "$ref": "#/entities/Company"
      },
      "description": "Company records isolated by user_id."
    },
    "/bast_documents/{bastId}": {
      "schema": {
        "$ref": "#/entities/BastDocument"
      },
      "description": "BAST documents isolated by user_id."
    },
    "/bast_items/{itemId}": {
      "schema": {
        "$ref": "#/entities/BastItem"
      },
      "description": "BAST line items isolated by user_id and linked to bast_id."
    },
    "/settings/{userId}": {
      "schema": {
        "$ref": "#/entities/Settings"
      },
      "description": "User-specific application and document settings keyed by userId."
    }
  }
}
