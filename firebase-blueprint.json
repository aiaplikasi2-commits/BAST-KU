{
  "entities": {
    "AuthAccount": {
      "title": "AuthAccount",
      "description": "Online encrypted PBKDF2-SHA256 authentication account record for Email/Password login.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic user UID (usr_<16hex>)."
        },
        "uid": {
          "type": "string",
          "description": "Deterministic user UID (usr_<16hex>)."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Normalized lowercase user email."
        },
        "displayName": {
          "type": "string",
          "description": "User full name or display name."
        },
        "saltHex": {
          "type": "string",
          "description": "Random 16-byte cryptographic salt encoded as hex."
        },
        "hashHex": {
          "type": "string",
          "description": "PBKDF2-SHA256 derived key hash encoded as hex."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "email",
        "displayName",
        "saltHex",
        "hashHex",
        "created_at",
        "updated_at"
      ]
    },
    "User": {
      "title": "User",
      "description": "Authenticated user profile record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID or deterministic user ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address."
        },
        "name": {
          "type": "string",
          "description": "Display name of the user."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "email", "name", "created_at", "updated_at"]
    },
    "Company": {
