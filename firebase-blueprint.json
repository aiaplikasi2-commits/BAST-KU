          "type": "string"
        },
        "alamat": {
          "type": "string"
        },
        "kota": {
          "type": "string"
        },
        "kode_pos": {
          "type": "string"
        },
        "telepon": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "logo": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "user_id",
        "no",
        "nama_pt",
        "nama_pejabat",
        "jabatan_pejabat",
        "alamat",
        "kota",
        "kode_pos",
        "telepon",
